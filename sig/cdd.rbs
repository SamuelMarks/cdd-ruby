# frozen_string_literal: true

module Cdd
  VERSION: String

  type json_scalar = String | Integer | Float | bool | nil
  type json_value = json_scalar | Array[json_value] | Hash[String, json_value]
  type json_object = Hash[String, json_value]
  type ripper_token = [[Integer, Integer], Symbol, String, Array[String]?]

  class Error < StandardError
  end

  class ParseError < Error
  end

  class EmitError < Error
  end

  class ValidationError < Error
  end

  class ArazzoValidationError < ValidationError
  end

  class RuntimeExpressionError < Error
  end

  class RpcError < Error
    attr_reader code: Integer
    def initialize: (String message, ?code: Integer) -> void
  end

  class McpError < Error
  end

  class UnsupportedEnvironmentError < Error
  end

  class Config
    ATTRIBUTES: Array[Symbol]
    CLI_OPTION_SPECS: Array[[Symbol, String, bool]]
    ATTRIBUTE_ALIASES: Hash[Symbol, Array[Symbol]]

    attr_accessor subcommand: String?
    attr_accessor input: String?
    attr_accessor output: String?
    attr_accessor input_dir: String?
    attr_accessor arazzo: String?
    attr_accessor no_imports: bool?
    attr_accessor no_wrapping: bool?
    attr_accessor no_github_actions: bool?
    attr_accessor no_installable_package: bool?
    attr_accessor tests: bool?
    attr_accessor mcp: bool?
    attr_accessor truth: String?
    attr_accessor with_ephemeral: bool?
    attr_accessor with_seed: bool?
    attr_accessor port: (Integer | String)?
    attr_accessor listen: String?

    def initialize: (?Hash[Symbol | String, json_value] opts) -> void
    def []: (Symbol | String key) -> json_value
    def to_h: () -> Hash[Symbol, json_value]
    def to_a: () -> Array[String]
  end

  class IR
    class Info < Data
      attr_reader title: String
      attr_reader version: String
      attr_reader summary: String?
      attr_reader description: String?
      attr_reader terms_of_service: String?
      attr_reader contact: json_object?
      attr_reader license: json_object?
    end

    class ServerVariable < Data
      attr_reader default: String
      attr_reader enum: Array[String]?
      attr_reader description: String?
    end

    class Server < Data
      attr_reader url: String
      attr_reader description: String?
      attr_reader variables: Hash[String, ServerVariable]
    end

    class Property < Data
      attr_reader name: String
      attr_reader type: String?
      attr_reader description: String?
      attr_reader example: json_value
      attr_reader ref: String?
      attr_reader read_only: bool?
    end

    class Schema < Data
      attr_reader name: String
      attr_reader type: String?
      attr_reader properties: Array[Property]
      attr_reader required: Array[String]
      attr_reader all_of: Array[json_object]?
      attr_reader one_of: Array[json_object]?
      attr_reader any_of: Array[json_object]?
      attr_reader discriminator: json_object?
      attr_reader xml: json_object?
      attr_reader example: json_value
      attr_reader description: String?
      attr_reader read_only: bool?
    end

    class Parameter < Data
      attr_reader name: String
      attr_reader in_location: String?
      attr_reader schema: json_object?
      attr_reader required: bool
      attr_reader description: String?
      attr_reader style: String?
      attr_reader explode: bool?
      attr_reader allow_reserved: bool?
      attr_reader allow_empty_value: bool?
      attr_reader deprecated: bool?
      attr_reader examples: json_object?
      attr_reader collection_format: String?
      attr_reader items: json_object?
    end

    class Encoding < Data
      attr_reader content_type: String?
      attr_reader headers: json_object?
      attr_reader style: String?
      attr_reader explode: bool?
      attr_reader allow_reserved: bool?
      attr_reader description: String?
      attr_reader prefix_encoding: Array[Encoding]
      attr_reader item_encoding: Encoding?
    end

    class MediaType < Data
      attr_reader schema: json_object?
      attr_reader item_schema: json_object?
      attr_reader example: json_value
      attr_reader examples: json_object?
      attr_reader encoding: Hash[String, Encoding]
      attr_reader prefix_encoding: Array[Encoding]
      attr_reader item_encoding: Encoding?
    end

    class RequestBody < Data
      attr_reader description: String?
      attr_reader content: Hash[String, MediaType]
      attr_reader required: bool?
    end

    class Header < Data
      attr_reader description: String?
      attr_reader schema: json_object?
      attr_reader required: bool?
      attr_reader deprecated: bool?
      attr_reader example: json_value
      attr_reader examples: json_object?
      attr_reader collection_format: String?
      attr_reader items: json_object?
    end

    class Link < Data
      attr_reader operation_ref: String?
      attr_reader operation_id: String?
      attr_reader parameters: json_object?
      attr_reader request_body: json_value
      attr_reader description: String?
      attr_reader server: json_object?
    end

    class Response < Data
      attr_reader status: String
      attr_reader description: String?
      attr_reader headers: Hash[String, Header]
      attr_reader content: Hash[String, MediaType]
      attr_reader links: Hash[String, Link]
    end

    class Operation < Data
      attr_reader http_method: String
      attr_reader path: String
      attr_reader operation_id: String?
      attr_reader summary: String?
      attr_reader description: String?
      attr_reader tags: Array[String]
      attr_reader parameters: Array[Parameter]
      attr_reader request_body: RequestBody?
      attr_reader responses: Hash[String, Response]
      attr_reader callbacks: json_object?
      attr_reader security: Array[json_object]?
      attr_reader servers: Array[json_object]?
      attr_reader deprecated: bool?
      attr_reader external_docs: json_object?
      attr_reader produces: Array[String]?
    end

    class PathItem < Data
      attr_reader path: String
      attr_reader summary: String?
      attr_reader description: String?
      attr_reader operations: Hash[String, Operation]
      attr_reader additional_operations: Hash[String, Operation]
      attr_reader parameters: Array[Parameter]
      attr_reader servers: Array[json_object]?
      attr_reader ref: String?
    end

    class OAuthFlows < Data
      attr_reader implicit: json_object?
      attr_reader password: json_object?
      attr_reader client_credentials: json_object?
      attr_reader authorization_code: json_object?
      attr_reader device_authorization: json_object?
    end

    class SecurityScheme < Data
      attr_reader name: String
      attr_reader type: String?
      attr_reader description: String?
      attr_reader param_name: String?
      attr_reader in_location: String?
      attr_reader scheme: String?
      attr_reader bearer_format: String?
      attr_reader flows: OAuthFlows?
      attr_reader open_id_connect_url: String?
      attr_reader oauth2_metadata_url: String?
      attr_reader authorization_url: String?
    end

    class Example < Data
      attr_reader name: String
      attr_reader schema_ref: String?
      attr_reader summary: String?
      attr_reader description: String?
      attr_reader value: json_value
      attr_reader data_value: json_value
      attr_reader serialized_value: String?
      attr_reader external_value: String?
    end

    class ArazzoSpec < Data
      attr_reader arazzo: String
      attr_reader self_uri: String?
      attr_reader info: ArazzoInfo
      attr_reader source_descriptions: Array[SourceDescription]
      attr_reader workflows: Array[Workflow]
      attr_reader components: ArazzoComponents?
      attr_reader extensions: json_object
    end

    class ArazzoInfo < Data
      attr_reader title: String
      attr_reader summary: String?
      attr_reader description: String?
      attr_reader version: String
      attr_reader extensions: json_object
    end

    class SourceDescription < Data
      attr_reader name: String
      attr_reader url: String
      attr_reader type: String
      attr_reader extensions: json_object
    end

    class Workflow < Data
      attr_reader workflow_id: String
      attr_reader summary: String?
      attr_reader description: String?
      attr_reader inputs: json_object?
      attr_reader depends_on: Array[String]?
      attr_reader steps: Array[Step]
      attr_reader success_actions: Array[SuccessAction | ReusableObject]
      attr_reader failure_actions: Array[FailureAction | ReusableObject]
      attr_reader outputs: Hash[String, String | Selector]
      attr_reader parameters: Array[ArazzoParameter | ReusableObject]
      attr_reader extensions: json_object
    end

    class Step < Data
      attr_reader step_id: String
      attr_reader description: String?
      attr_reader operation_id: String?
      attr_reader operation_path: String?
      attr_reader channel_path: String?
      attr_reader workflow_id: String?
      attr_reader parameters: Array[ArazzoParameter | ReusableObject]
      attr_reader request_body: ArazzoRequestBody?
      attr_reader success_criteria: Array[Criterion]
      attr_reader on_success: Array[SuccessAction | ReusableObject]
      attr_reader on_failure: Array[FailureAction | ReusableObject]
      attr_reader outputs: Hash[String, String | Selector]
      attr_reader timeout: (Integer | Float | String)?
      attr_reader correlation_id: String?
      attr_reader action: String?
      attr_reader depends_on: Array[String]?
      attr_reader extensions: json_object
    end

    class ArazzoParameter < Data
      attr_reader name: String
      attr_reader in_location: String?
      attr_reader value: json_value
      attr_reader extensions: json_object
    end

    class ReusableObject < Data
      attr_reader reference: String
      attr_reader value: json_value
    end

    class SuccessAction < Data
      attr_reader name: String
      attr_reader type: String
      attr_reader workflow_id: String?
      attr_reader step_id: String?
      attr_reader parameters: Array[ArazzoParameter | ReusableObject]
      attr_reader criteria: Array[Criterion]
      attr_reader extensions: json_object
    end

    class FailureAction < Data
      attr_reader name: String
      attr_reader type: String
      attr_reader workflow_id: String?
      attr_reader step_id: String?
      attr_reader parameters: Array[ArazzoParameter | ReusableObject]
      attr_reader retry_after: (Integer | Float)?
      attr_reader retry_limit: Integer?
      attr_reader criteria: Array[Criterion]
      attr_reader extensions: json_object
    end

    class Criterion < Data
      attr_reader context: String?
      attr_reader condition: String
      attr_reader type: (String | ExpressionType)?
      attr_reader extensions: json_object
    end

    class ExpressionType < Data
      attr_reader type: String
      attr_reader version: String?
      attr_reader extensions: json_object
    end

    class Selector < Data
      attr_reader context: String
      attr_reader selector: String
      attr_reader type: (String | ExpressionType)?
      attr_reader extensions: json_object
    end

    class ArazzoRequestBody < Data
      attr_reader content_type: String?
      attr_reader payload: json_value
      attr_reader replacements: Array[PayloadReplacement]
      attr_reader extensions: json_object
    end

    class PayloadReplacement < Data
      attr_reader target: String
      attr_reader target_selector_type: (String | ExpressionType)?
      attr_reader value: json_value
      attr_reader extensions: json_object
    end

    class ArazzoComponents < Data
      attr_reader inputs: Hash[String, json_object]
      attr_reader parameters: Hash[String, ArazzoParameter | ReusableObject]
      attr_reader success_actions: Hash[String, SuccessAction | ReusableObject]
      attr_reader failure_actions: Hash[String, FailureAction | ReusableObject]
      attr_reader extensions: json_object
    end

    attr_accessor classes: Array[String]
    attr_accessor routes: Array[String]
    attr_accessor openapi_spec: json_object
    attr_accessor tests: Array[String]
    attr_accessor mocks: Array[String]
    attr_accessor arazzo_spec: json_object
    attr_accessor workflows: Array[String]

    def initialize: (?json_object? openapi_spec, ?json_object? arazzo_spec) -> void
    def self.from_openapi_hash: (json_object hash) -> IR
    def self.from_arazzo_hash: (json_object hash) -> IR
    def self.extract_extensions: (json_object? raw) -> json_object
    def self.build_arazzo_param_or_ref: (json_object raw) -> (ArazzoParameter | ReusableObject)
    def self.build_criterion: (json_object raw) -> Criterion
    def self.build_success_action: (json_object raw) -> (SuccessAction | ReusableObject)
    def self.build_failure_action: (json_object raw) -> (FailureAction | ReusableObject)
    def self.build_output_value: (String | json_object val) -> (String | Selector)
    def self.build_arazzo_request_body: (json_object? raw) -> ArazzoRequestBody?
    def self.build_step: (json_object raw) -> Step
    def self.build_workflow: (json_object raw) -> Workflow
    def self.build_arazzo_components: (json_object? raw) -> ArazzoComponents?
    def self.build_parameter: (json_object raw) -> Parameter
    def self.build_encoding: (json_object raw) -> Encoding
    def self.build_media_type: (json_object raw) -> MediaType
    def self.build_request_body: (json_object? raw) -> RequestBody?
    def self.build_response: (String status, json_object raw) -> Response
    def self.build_operation: (String http_method, String path, json_object raw) -> Operation
    def self.build_path_item_operations: (String path, json_object raw) -> [Hash[String, Operation], Hash[String, Operation]]
    def to_openapi_hash: () -> json_object
    def to_arazzo_hash: () -> json_object
    def typed_arazzo: () -> ArazzoSpec
    def typed_info: () -> Info
    def typed_servers: () -> Array[Server]
    def typed_schemas: () -> Array[Schema]
    def typed_paths: () -> Array[PathItem]
    def typed_security_schemes: () -> Array[SecurityScheme]
    def typed_examples: () -> Array[Example]
    def to_h: () -> Hash[String, json_value]
  end

  module TokenScanner
    SINATRA_HTTP_VERBS: Array[String]
    DISQUALIFYING_PREV_TYPES: Array[Symbol]
    SCAFFOLDING_CLASSES: Array[String]

    def self.scaffolding_class?: (String name) -> bool
    def self.operation_id_for: (String method, String path, ?json_object details, ?collapse: bool) -> String
    def self.single_quote_literal: (String str) -> String
    def self.classify_name: (String | Symbol name) -> String
    def self.pluralize: (String | Symbol word) -> String
    def self.first_request_body_schema: (json_object op) -> json_object?
    def self.singularize_candidates: (String | Symbol word) -> Array[String]
    def self.table_columns_for_schema: (json_object schema) -> Array[[String, String]]
    def self.sample_body_hash_literal: (?json_object? schema, ?symbol_keys: bool) -> String
    def self.sample_param_value: (json_object param) -> String
    def self.parse_composition_schema: (String composition_key, String rest) -> json_object
    def self.parse_discriminator_options: (Array[String] parts) -> json_object?
    def self.parse_sinatra_routes: (Array[ripper_token] tokens, IR ir) -> void
    def self.extract_route_path_literal: (Array[ripper_token] tokens, Integer idx) -> String?
    def self.skip_spaces: (Array[ripper_token] tokens, Integer start_idx) -> Integer
    def self.register_sinatra_route: (IR ir, String method, String path) -> void
  end

  module Arazzo
    class RuntimeExpression
      VALID_ROOTS: Array[String]
      def self.valid?: (json_value expr) -> bool
      def self.evaluate: (json_value expr, ?Hash[Symbol | String, json_value] context) -> json_value
      def self.evaluate_collection: (Hash[String, json_value] | Array[json_value] collection, Hash[Symbol | String, json_value] context) -> (Hash[String, json_value] | Array[json_value])
      def self.evaluate_single: (String expr, Hash[Symbol | String, json_value] context) -> json_value
      def self.evaluate_envelope: (String expr, Hash[Symbol | String, json_value] context) -> json_value
      def self.evaluate_body_or_payload: (Hash[String, json_value] env, String rest) -> json_value
      def self.evaluate_namespace: (String namespace, String rest, Hash[Symbol | String, json_value] context) -> json_value
      def self.lookup_path: (json_value target, String path_str) -> json_value
      def self.resolve_json_pointer: (json_value data, String? pointer) -> json_value
      def self.lookup_case_insensitive: (json_value hash, String key) -> json_value
      def self.fetch_ctx: (json_value hash, Symbol sym) -> json_value
      def self.parse_json_if_string: (json_value val) -> json_value
      def self.to_ruby_expr: (json_value expr) -> String
      def self.translate_direct_ruby_expr: (String expr) -> String
      def self.from_ruby_expr: (String ruby_code) -> String
    end

    class CriterionEvaluator
      def self.evaluate: (IR::Criterion | json_object criterion, ?Hash[Symbol | String, json_value] context) -> bool
      def self.extract_type_and_version: (String | IR::ExpressionType | json_object | nil type_spec) -> [String?, String?]
      def self.evaluate_simple: (String condition, json_value target_val, Hash[Symbol | String, json_value] context) -> bool
      def self.split_outside_quotes: (String str, String delimiter) -> Array[String]
      def self.resolve_operand: (String token, json_value target_val, Hash[Symbol | String, json_value] context) -> json_value
      def self.values_match?: (json_value lhs, String op, json_value rhs) -> bool
      def self.numeric_operand: (json_value val) -> Float?
      def self.jsonpath_criterion_match?: (String condition, json_value target_val, ?String? _version) -> bool
      def self.xpath_criterion_match?: (String condition, json_value target_val, ?String? _version) -> bool
    end

    class SelectorEvaluator
      def self.extract: (String | IR::Selector | json_object selector_or_expr, ?Hash[Symbol | String, json_value] context) -> json_value
      def self.query_jsonpath: (json_value data, String query) -> json_value
      def self.apply_jsonpath_filter: (json_value list, String filter_expr) -> Array[json_value]
      def self.query_xpath: (String xml_str, String xpath_expr) -> String?
    end

    class PayloadReplacer
      def self.apply: (json_value payload, Array[IR::PayloadReplacement | json_object]? replacements, ?Hash[Symbol | String, json_value] context) -> json_value
      def self.apply_single: (json_value current, String target, (String | IR::ExpressionType | json_object)? selector_type, json_value val) -> json_value
      def self.replace_json_pointer: (json_value data, String pointer, json_value val) -> json_value
      def self.navigate_pointer_parent: (json_value data, Array[String] segments) -> json_value
      def self.replace_xpath: (String xml_str, String xpath_expr, json_value val) -> String
      def self.deep_copy: (json_value obj) -> json_value
    end

    class Emitter
      def self.emit: (IR ir) -> String
      def self.emit_root_lines: (IR ir) -> Array[String]
      def self.emit_info_lines: (IR::ArazzoInfo typed_info, json_object raw_info) -> Array[String]
      def self.emit_source_lines: (Array[json_object] sources) -> Array[String]
      def self.emit_component_lines: (json_object? components) -> Array[String]
      def self.emit_extension_lines: (String tag_name, json_object obj, ?String indent) -> Array[String]
      def self.emit_workflow_lines: (json_object workflow) -> Array[String]
      def self.emit_workflow_tag_lines: (json_object workflow) -> Array[String]
      def self.emit_step_lines: (json_object step) -> Array[String]
      def self.build_step_call_expr: (json_object step) -> String
      def self.build_step_call_args: (json_object step) -> Array[String]
      def self.format_output_extraction: (String step_id, String | json_object out_val) -> String
      def self.emit_workflow_return_line: (json_object outputs) -> String
    end

    class Parser
      CLIENT_CALL_REGEX: Regexp

      def self.parse: (Array[ripper_token] tokens, IR ir) -> void
      def self.parse_comment_line: (String line, json_object spec, IR ir, json_object? current_wf) -> json_object?
      def self.parse_json_tag: (String raw_json) -> json_value
      def self.parse_root_tag: (String line, json_object spec) -> void
      def self.apply_workflow_attribute_tag: (String line, json_object current_wf) -> void
      def self.infer_unannotated_workflows: (Array[ripper_token] tokens, IR ir) -> void
      def self.infer_steps_from_method_body: (String body) -> Array[json_object]
      def self.build_inferred_client_step: (String? assign_var, String op_id, String? raw_args, Integer index, Hash[String, json_object] var_to_step) -> json_object
      def self.infer_step_params: (String args_str, Hash[String, json_object] var_to_step) -> Array[json_object]
      def self.resolve_inferred_param_rhs: (String rhs, Hash[String, json_object] var_to_step) -> String
      def self.synthesize_default_source: (IR ir) -> void
    end
  end

  module Classes
    class Emitter
      def self.emit: (IR ir) -> String
      def self.emit_security_schemes: (Hash[String, json_object] security_schemes, ?String tag_name) -> String
      def self.format_security_scheme_options: (json_object scheme) -> Array[String]
      def self.emit_composition_schema: (String tag_name, String name, Array[json_object] refs_array, json_object? discriminator) -> String
      def self.emit_object_schema: (IR::Schema schema, json_object raw_schema) -> String
      def self.format_class_header: (String name, Array[json_object]? all_of) -> String
    end

    class Parser
      def self.parse: (Array[ripper_token] tokens, IR ir) -> void
      def self.parse_class_comment: (String comment, String? current_class, IR ir) -> void
      def self.parse_class_declaration: (Array[ripper_token] tokens, Integer idx, IR ir) -> String?
      def self.extract_parent_class: (Array[ripper_token] tokens, Integer idx) -> String?
      def self.parse_attr_accessor: (Array[ripper_token] tokens, Integer idx, String current_class, IR ir) -> void
      def self.ensure_schemas: (IR ir) -> Hash[String, json_object]
      def self.ensure_class_schema: (IR ir, String class_name) -> json_object
    end
  end

  module ClientSdk
    module IntegrationSpecEmitter
      def write_sdk_artifacts: (Hash[Symbol, json_value] options, json_object openapi, String models_code, String client_code, ?String workflows_code) -> void
      def emit_sdk_integration_spec: (json_object openapi) -> String
      def emit_single_integration_example: (Hash[Symbol, json_value] path_entry) -> String
      def build_integration_params_str: (json_object details) -> String
    end

    class Emitter
      extend IntegrationSpecEmitter

      def self.emit_sdk: (Hash[Symbol, json_value] options) -> String
      def self.split_openapi_and_arazzo: (json_object raw_spec, ?String? arazzo_path) -> [json_object, json_object?]
      def self.emit_workflows_code: (json_object? arazzo) -> String
      def self.emit_models: (json_object openapi) -> String
      def self.resolve_default_url: (json_object openapi) -> String
      def self.emit_client_class: (json_object openapi) -> String
      def self.emit_oauth2_helper: (json_object openapi) -> String
      def self.emit_operation_method: (String path, String method, json_object details) -> String
      def self.emit_operation_doc_comments: (String path, json_object details) -> String
      def self.emit_request_body_doc_comments: (json_object request_body) -> String
      def self.emit_responses_doc_comments: (json_object? responses) -> String
      def self.partition_parameter_keys: (Array[json_object] parameters) -> [Array[String], Array[String], String?]
      def self.emit_request_body_handling: (String method, json_object details, String? body_key) -> String
      def self.resolve_content_type: (json_object details) -> String
      def self.emit_examples_and_webhooks: (json_object openapi) -> String
      def self.emit_auth_adapter: () -> String
      def self.emit_mcp_adapter: (json_object openapi, ?json_object? arazzo) -> String
    end

    class Parser
      INTERNAL_SDK_METHODS: Array[String]
      NET_HTTP_CONSTS: Array[String]

      def self.parse: (Array[ripper_token] tokens, IR ir, ?skip_arazzo: bool) -> void
      def self.step_sdk_token: (Array[ripper_token] tokens, ripper_token token, Integer idx, Hash[Symbol, json_value] state, IR ir) -> void
      def self.handle_sdk_def: (Array[ripper_token] tokens, Integer idx, IR ir) -> [String?, bool]
      def self.handle_req_path: (Array[ripper_token] tokens, Integer idx, String? op_id, IR ir) -> [bool, nil]
      def self.detect_net_http_method: (Array[ripper_token] slice) -> String
    end
  end

  module ClientSdkCli
    class Emitter
      def self.emit_sdk_cli: (Hash[Symbol, json_value] options) -> String
      def self.build_mcp_tools: (json_object openapi, ?json_object? arazzo) -> Array[Hash[Symbol, json_value]]
      def self.append_arazzo_mcp_tools: (Array[Hash[Symbol, json_value]] tools_array, json_object arazzo) -> void
      def self.emit_header_and_help: (json_object openapi, ?json_object? arazzo) -> String
      def self.emit_help_workflows: (Array[json_object]? workflows) -> String
      def self.emit_help_servers: (Array[json_object]? servers) -> String
      def self.emit_help_components: (json_object? components) -> String
      def self.emit_help_security_schemes: (json_object? security_schemes) -> String
      def self.emit_help_schemas: (json_object? schemas) -> String
      def self.emit_help_paths: (json_object? paths) -> String
      def self.common_mcp_branch_lines: (?String indent) -> String
